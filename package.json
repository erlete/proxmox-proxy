{
  "name": "proxmox-proxy",
  "version": "0.5.1",
  "private": true,
  "description": "Single control-plane entrypoint for apps sharing a Proxmox VE cluster",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/classify.test.ts test/keys.test.ts test/session.test.ts test/admission.test.ts test/failclosed.test.ts test/e2e.test.ts",
    "openapi": "tsx scripts/emit-openapi.ts && openapi-typescript panel/openapi.json -o panel/src/api/schema.d.ts",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@sinclair/typebox": "^0.34.0",
    "fastify": "^5.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
