# ---- Upstream cluster -------------------------------------------------------
# Base URL of the Proxmox VE API (pveproxy) this instance guards.
PROXMOX_UPSTREAM_URL=https://192.0.2.10:8006
# Service token the proxy uses against Proxmox for EVERY upstream call.
# Needs: VM.* on the guarded VMs, Sys.Audit, and Pool.Allocate on /pool
# (the singleton lock lives in a pool comment). "PVEAPIToken=" prefix optional.
PROXMOX_SERVICE_TOKEN=svc-proxy@pve!proxy=00000000-0000-0000-0000-000000000000
# Path to a CA bundle for the upstream TLS cert. Empty = system CAs.
PROXMOX_UPSTREAM_TLS_CA=
# Accept any upstream cert (lab only, never in production).
PROXMOX_UPSTREAM_TLS_INSECURE=false
# Base URL apps must use for direct VNC websockets (returned by /proxy/whoami).
# Defaults to PROXMOX_UPSTREAM_URL.
PROXMOX_PUBLIC_WS_URL=

# ---- Issued API keys --------------------------------------------------------
# Identity prefix of the keys the proxy issues to apps. Keys look like
#   PVEAPIToken=<KEYS_TOKEN_USER>!<key-name>=<secret>
# so any stock Proxmox SDK can send them unchanged.
KEYS_TOKEN_USER=svc-proxy@pve

# ---- Panel / admin ----------------------------------------------------------
ADMIN_USER=admin
# Preferred: scrypt hash produced by `npm run hash-password -- <password>`.
ADMIN_PASSWORD_HASH=
# Fallback plain password (discouraged; hash wins when both are set).
ADMIN_PASSWORD=
# HMAC secret for session cookies. Empty = random per boot (sessions reset).
SESSION_SECRET=
# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ---- Singleton lock ---------------------------------------------------------
# Only one proxy may guard a cluster. The lock is a heartbeat marker stored in
# the comment of this Proxmox pool. A second instance refuses to start while
# the marker is fresh.
SINGLETON_POOL=proxyguard
SINGLETON_HEARTBEAT_SECONDS=60
SINGLETON_STALE_SECONDS=300
# Skip the lock entirely (local development without a cluster).
SINGLETON_DISABLED=false

# ---- Admission control ------------------------------------------------------
# Max concurrent heavy operations per class. A slot is held until the Proxmox
# TASK finishes, not just the HTTP request.
ADMISSION_CLONE_CAP=2
ADMISSION_DELETE_CAP=1
ADMISSION_SUSPEND_CAP=1
# Max requests waiting per class before answering 429.
ADMISSION_MAX_QUEUE=32
# Max time a request is held waiting for a slot before answering 429 (ms).
ADMISSION_MAX_HOLD_MS=25000
# Poll interval for tracked task status (ms) and per-task safety timeout (ms).
ADMISSION_TASK_POLL_MS=2000
ADMISSION_TASK_TIMEOUT_MS=600000

# ---- Storage / ports --------------------------------------------------------
DATA_DIR=/data
BIND_HOST=0.0.0.0
DATA_PORT=8080
ADMIN_PORT=8081
# Operation log ring size (rows kept in SQLite).
OPS_RING_MAX=20000

# ---- Edge (compose / Caddy) -------------------------------------------------
PROXY_DOMAIN=proxy.localhost
PANEL_ALLOWLIST=private_ranges
