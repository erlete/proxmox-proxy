# proxmox-proxy: minimal configuration. Anything not set here is generated on
# first boot (and persisted) or has a sane default. Runtime tunables (admission
# caps, queueing, session TTL, websocket base, log size) are NOT env vars:
# they are managed from the panel (Settings) and applied hot.

# ---- Required ---------------------------------------------------------------
# Proxmox VE API (pveproxy) this instance guards.
PROXMOX_UPSTREAM_URL=https://192.0.2.10:8006
# Service token the proxy uses for every upstream call. Needs VM.* on the
# guarded VMs, Sys.Audit, and Pool.Allocate on /pool (the singleton lock
# lives in a pool comment). "PVEAPIToken=" prefix optional.
PROXMOX_SERVICE_TOKEN=svc-proxy@pve!proxy=00000000-0000-0000-0000-000000000000

# ---- Deployment -------------------------------------------------------------
# Network and port where Caddy (the only exposed container) listens.
# Default: loopback only. Set DEPLOY_HOST=0.0.0.0 to expose it.
#DEPLOY_HOST=127.0.0.1
#DEPLOY_PORT=8000

# ---- Panel ------------------------------------------------------------------
# If neither is set, a password is generated on first boot, persisted, and
# printed ONCE in the logs. ADMIN_PASSWORD_HASH (npm run hash-password) wins.
#ADMIN_PASSWORD=
#ADMIN_PASSWORD_HASH=
#ADMIN_USER=admin

# ---- Console sessions (optional) --------------------------------------------
# Dedicated LOW-PRIVILEGE Proxmox identity (VM.Console only) with a password:
# lets the proxy mint VNC console credentials via POST /proxy/console-session
# so apps open websockets directly against the cluster without holding any
# Proxmox credential. Unset = the endpoint answers 501.
#PROXMOX_CONSOLE_USERNAME=svc-console@pve
#PROXMOX_CONSOLE_PASSWORD=

# ---- Advanced boot-level (defaults shown) -----------------------------------
# TLS towards the upstream: CA bundle path, or insecure for labs.
#PROXMOX_UPSTREAM_TLS_CA=
#PROXMOX_UPSTREAM_TLS_INSECURE=false
# Identity prefix of issued keys: PVEAPIToken=<user>!<key-name>=<secret>
#KEYS_TOKEN_USER=svc-proxy@pve
# Session cookie signing secret; auto-generated and persisted when empty.
#SESSION_SECRET=
# Singleton lock (one proxy per cluster). The lock is a heartbeat marker in
# the comment of this pool; a rival instance refuses to start while fresh.
#SINGLETON_POOL=proxyguard
#SINGLETON_HEARTBEAT_SECONDS=60
#SINGLETON_STALE_SECONDS=300
#SINGLETON_DISABLED=false
# Internal listeners and storage (behind Caddy; rarely touched).
#DATA_DIR=/data
#BIND_HOST=0.0.0.0
#DATA_PORT=8080
#ADMIN_PORT=8081
