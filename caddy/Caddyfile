# Single entrypoint, routed by path. TLS/domains are the perimeter's job:
# by default this listens plain HTTP on the network chosen via DEPLOY_HOST.
{
	auto_https off
}

:8000 {
	# Data plane: what the apps point their Proxmox client at.
	@data path /api2/* /proxy/*
	handle @data {
		reverse_proxy proxy:8080 {
			transport http {
				# Held heavy operations can wait for an admission slot:
				# the edge must not cut them off first.
				response_header_timeout 90s
			}
		}
	}

	# Management plane: panel + admin API (session-authenticated).
	handle {
		reverse_proxy proxy:8081 {
			# SSE for the live queue view.
			flush_interval -1
		}
	}
}
